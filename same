<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <meta http-equiv="X-Frame-Options" content="DENY">
    <meta http-equiv="X-Content-Type-Options" content="nosniff">
    <meta http-equiv="X-XSS-Protection" content="1; mode=block">
    
    <title>المنصة الرقمية القرمانى اكس | Alqurmani X</title>
    <meta name="description" content="الواجهة الرئيسية لمنصة القرماني إكس الفاخرة.">
    
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;700;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        /* ===================== التنسيقات الأساسية ===================== */
        :root {
            --bg-color: #0b0f19;
            --sidebar-bg: rgba(11, 15, 25, 0.95);
            --gold: #d4af37;
            --neon-blue: #00d4ff;
            --text-light: #e0e0e0;
        }

        body {
            margin: 0;
            padding: 0;
            font-family: 'Cairo', sans-serif;
            background-color: var(--bg-color);
            color: var(--text-light);
            overflow-x: hidden;
        }

        /* ===================== النقاط الذهبية المتطايرة ===================== */
        #particles-container {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            pointer-events: none; z-index: -1;
        }
        .gold-particle {
            position: absolute;
            background: var(--gold);
            border-radius: 50%;
            box-shadow: 0 0 8px var(--gold);
            opacity: 0;
            animation: floatParticles linear infinite;
        }
        @keyframes floatParticles {
            0% { transform: translateY(100vh) scale(0); opacity: 0; }
            20% { opacity: 0.8; transform: translateY(80vh) scale(1) translateX(20px); }
            80% { opacity: 0.5; transform: translateY(20vh) scale(1.2) translateX(-20px); }
            100% { transform: translateY(-10vh) scale(0); opacity: 0; }
        }

        /* ===================== زر الهامبرغر (4 شرائط يمين الشاشة) ===================== */
        .menu-btn {
            position: fixed;
            top: 25px;
            right: 25px;
            width: 35px;
            height: 28px;
            cursor: pointer;
            z-index: 10000;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            background: rgba(0,0,0,0.5);
            padding: 10px;
            border-radius: 8px;
            border: 1px solid var(--gold);
            box-shadow: 0 0 10px rgba(212, 175, 55, 0.3);
        }
        .menu-btn span {
            display: block;
            height: 3px;
            width: 100%;
            background: var(--gold);
            border-radius: 3px;
            transition: all 0.4s ease;
        }
        .menu-btn:hover span {
            box-shadow: 0 0 8px var(--gold);
        }

        /* ===================== القائمة الجانبية (من الشمال لليمين) ===================== */
        .overlay {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0,0,0,0.7);
            backdrop-filter: blur(5px);
            z-index: 9998;
            opacity: 0; visibility: hidden;
            transition: 0.4s ease;
        }
        .overlay.active { opacity: 1; visibility: visible; }

        .sidebar {
            position: fixed;
            top: 0;
            left: -350px; /* البداية من أقصى الشمال خارج الشاشة */
            width: 320px;
            height: 100vh;
            background: var(--sidebar-bg);
            border-right: 2px solid var(--gold);
            z-index: 9999;
            overflow-y: auto;
            transition: left 0.5s cubic-bezier(0.4, 0, 0.2, 1);
            box-shadow: 10px 0 30px rgba(0,0,0,0.9);
            padding-bottom: 30px;
        }
        .sidebar.active { left: 0; /* الاستقرار في الشاشة بعد القدوم من الشمال */ }

        .sidebar::-webkit-scrollbar { width: 6px; }
        .sidebar::-webkit-scrollbar-track { background: #050810; }
        .sidebar::-webkit-scrollbar-thumb { background: var(--gold); border-radius: 10px; }

        .close-btn {
            position: absolute;
            top: 15px; right: 20px;
            font-size: 30px;
            color: #ff4c4c;
            cursor: pointer;
            transition: 0.3s;
            font-weight: bold;
        }
        .close-btn:hover { color: #fff; text-shadow: 0 0 10px #ff4c4c; transform: rotate(90deg); }

        /* ===================== محتوى القائمة ===================== */
        .sidebar-header {
            text-align: center;
            padding: 40px 20px 20px;
            border-bottom: 1px solid rgba(212, 175, 55, 0.2);
        }
        .neon-title {
            font-size: 32px;
            font-weight: 900;
            color: #fff;
            margin: 0;
            text-transform: uppercase;
            letter-spacing: 2px;
            text-shadow: 0 0 5px var(--neon-blue), 0 0 15px var(--neon-blue), 0 0 30px var(--neon-blue);
        }
        .datetime {
            margin-top: 10px;
            font-size: 14px;
            color: #aaa;
            background: rgba(255,255,255,0.05);
            padding: 8px;
            border-radius: 5px;
        }

        /* الأيقونات الاجتماعية الحقيقية */
        .social-icons {
            display: flex;
            justify-content: center;
            gap: 20px;
            margin-top: 15px;
        }
        .social-icons a {
            text-decoration: none;
            font-size: 24px;
            color: var(--gold);
            transition: transform 0.3s, color 0.3s;
        }
        .social-icons a:hover { 
            transform: translateY(-5px); 
            text-shadow: 0 0 15px var(--gold); 
        }
        .fa-facebook:hover { color: #1877F2; text-shadow: 0 0 15px #1877F2; }
        .fa-whatsapp:hover { color: #25D366; text-shadow: 0 0 15px #25D366; }
        .fa-telegram:hover { color: #0088cc; text-shadow: 0 0 15px #0088cc; }
        .fa-x-twitter:hover { color: #ffffff; text-shadow: 0 0 15px #ffffff; }

        /* روابط القائمة */
        .sidebar-menu { list-style: none; padding: 0; margin: 0; }
        .sidebar-menu li { border-bottom: 1px solid rgba(255,255,255,0.05); }
        .sidebar-menu a {
            display: flex;
            align-items: center;
            padding: 15px 25px;
            color: var(--text-light);
            text-decoration: none;
            font-size: 16px;
            font-weight: 700;
            transition: 0.3s;
        }
        .sidebar-menu a:hover, .sidebar-menu a.active-link {
            background: rgba(212, 175, 55, 0.1);
            color: var(--gold);
            padding-right: 35px;
        }
        
        /* القوائم المنسدلة */
        .has-dropdown > a { justify-content: space-between; }
        .arrow { font-size: 12px; transition: transform 0.3s; }
        .dropdown {
            list-style: none; padding: 0; margin: 0;
            max-height: 0; overflow: hidden;
            background: rgba(0,0,0,0.3);
            transition: max-height 0.5s ease;
        }
        .has-dropdown.open .dropdown { max-height: 500px; }
        .has-dropdown.open .arrow { transform: rotate(180deg); color: var(--gold); }
        .dropdown a { padding: 12px 45px 12px 20px; font-size: 14px; font-weight: 400; }

        /* أيقونات تسجيل الدخول الملونة */
        .auth-section { padding: 20px; text-align: center; }
        .auth-btn {
            display: inline-block;
            width: 90%;
            padding: 12px;
            border: 2px solid;
            border-radius: 8px;
            text-decoration: none;
            font-weight: bold;
            font-size: 16px;
            animation: colorCycle 6s infinite;
            background: transparent;
            cursor: pointer;
        }
        @keyframes colorCycle {
            0% { border-color: #ff0000; color: #ff0000; box-shadow: 0 0 10px rgba(255,0,0,0.5); }
            20% { border-color: #00ff00; color: #00ff00; box-shadow: 0 0 10px rgba(0,255,0,0.5); }
            40% { border-color: #0000ff; color: #0000ff; box-shadow: 0 0 10px rgba(0,0,255,0.5); }
            60% { border-color: #ff00ff; color: #ff00ff; box-shadow: 0 0 10px rgba(255,0,255,0.5); }
            80% { border-color: #00ffff; color: #00ffff; box-shadow: 0 0 10px rgba(0,255,255,0.5); }
            100% { border-color: #ff0000; color: #ff0000; box-shadow: 0 0 10px rgba(255,0,0,0.5); }
        }
    </style>

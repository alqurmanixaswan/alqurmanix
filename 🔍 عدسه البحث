<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>عدسة بحث القرماني إكس</title>
    
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;700;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        /* ========================================================
           تنسيقات عدسة البحث الفاخرة المحدثة
        ======================================================== */
        .alqurmani-search-widget {
            position: absolute; /* تم التغيير من fixed لـ absolute عشان تختفي مع النزول لتحت */
            top: 10px; /* نفس مستوى زر القائمة الجانبية بالضبط */
            left: 10px; /* أقصى أقصى الشمال */
            z-index: 10000;
            display: flex;
            align-items: center;
            background: rgba(11, 15, 25, 0.7);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border: 1px solid #d4af37;
            border-radius: 50px;
            box-shadow: 0 0 15px rgba(212, 175, 55, 0.3), inset 0 0 10px rgba(212, 175, 55, 0.1);
            width: 45px; /* تم تصغيرها قليلاً لتطابق حجم زر القائمة */
            height: 45px;
            overflow: hidden;
            transition: all 0.6s cubic-bezier(0.68, -0.55, 0.265, 1.55);
            direction: rtl;
        }

        .alqurmani-search-widget.active {
            width: 340px; 
            border-radius: 12px;
            background: rgba(11, 15, 25, 0.95);
            box-shadow: 0 0 25px rgba(0, 212, 255, 0.5), inset 0 0 15px rgba(212, 175, 55, 0.2);
            border-color: #00d4ff;
        }

        .q-search-icon-btn {
            min-width: 45px;
            height: 45px;
            display: flex;
            justify-content: center;
            align-items: center;
            color: #d4af37;
            font-size: 20px;
            cursor: pointer;
            transition: color 0.3s, transform 0.4s;
            background: transparent;
            border: none;
            outline: none;
        }

        .q-search-icon-btn:hover {
            color: #00d4ff;
            text-shadow: 0 0 15px #00d4ff;
            transform: scale(1.1);
        }

        .alqurmani-search-widget.active .q-search-icon-btn {
            color: #00d4ff;
            transform: rotate(90deg);
            pointer-events: none; 
        }

        .q-search-content-area {
            display: flex;
            flex-direction: column;
            justify-content: center;
            white-space: nowrap;
            opacity: 0;
            visibility: hidden;
            transform: translateX(-20px);
            transition: all 0.4s ease 0.2s; 
            width: 100%;
            padding-right: 5px;
        }

        .alqurmani-search-widget.active .q-search-content-area {
            opacity: 1;
            visibility: visible;
            transform: translateX(0);
        }

        .q-search-text-msg {
            color: #ffffff;
            font-family: 'Cairo', sans-serif;
            font-weight: 700;
            font-size: 14px;
            letter-spacing: 0.5px;
            margin-bottom: 8px;
            text-shadow: 0 0 8px rgba(0, 212, 255, 0.8);
        }

        .q-progress-track {
            width: 90%;
            height: 4px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 4px;
            overflow: hidden;
            box-shadow: inset 0 0 5px rgba(0,0,0,0.5);
        }

        .q-progress-fill-bar {
            height: 100%;
            width: 0%;
            background: linear-gradient(90deg, #d4af37, #00d4ff, #d4af37);
            background-size: 200% 100%;
            border-radius: 4px;
            box-shadow: 0 0 10px #00d4ff, 0 0 5px #d4af37;
        }

        .alqurmani-search-widget.active .q-progress-fill-bar {
            animation: fillUpProgress 5s linear forwards, shimmer 2s infinite linear;
        }

        @keyframes fillUpProgress {
            0% { width: 0%; }
            100% { width: 100%; }
        }

        @keyframes shimmer {
            0% { background-position: 100% 0; }
            100% { background-position: -100% 0; }
        }
    </style>
</head>
<body>

    <div id="alqurmani-search" class="alqurmani-search-widget">
        <button id="q-search-trigger" class="q-search-icon-btn" title="بحث القرمانى إكس">
            <i class="fa-solid fa-magnifying-glass"></i>
        </button>
        
        <div class="q-search-content-area">
            <span class="q-search-text-msg">جاري التوجه لمحرك بحث القرمانى اكس...</span>
            <div class="q-progress-track">
                <div class="q-progress-fill-bar"></div>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const searchWidget = document.getElementById('alqurmani-search');
            const searchBtn = document.getElementById('q-search-trigger');
            
            const targetSearchURL = 'https://alqurmanix.alqurmanix.com/aqx-search.html'; 

            searchBtn.addEventListener('click', () => {
                if (!searchWidget.classList.contains('active')) {
                    searchWidget.classList.add('active');
                    
                    setTimeout(() => {
                        window.location.href = targetSearchURL;
                    }, 5000);
                }
            });
        });
    </script>

</body>
</html>
